# Ignore everything by default
*

# API keys — never commit
.env

# Unignore the .agent directory and its contents
!/.agent/
!/.agent/**

# Unignore essential project files
!/package.json
!/package-lock.json
!/README.md
!/.gitignore

# Re-ignore generated/local artifacts even inside .agent
**/__pycache__/
**/*.pyc
**/.DS_Store
.DS_Store
.venv/

# Explicitly ignore workspace and build artifacts
workspace/
node_modules/
*.log
